<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <EngineRootPath>../engine</EngineRootPath>
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>
  <PropertyGroup Condition="'$(CameoDevLogging)' != 'true'">
    <DefineConstants>$(DefineConstants);CAMEO_DEV_TEST_COMPILE</DefineConstants>
  </PropertyGroup>
  <Import Project="../engine/Directory.Build.props" />
  <ItemGroup>
    <ProjectReference Include="../OpenRA.Mods.CA/OpenRA.Mods.CA.csproj" />
    <ProjectReference Include="../OpenRA.Mods.Cameo/OpenRA.Mods.Cameo.csproj" />
    <Compile Include="../OpenRA.Mods.Cameo.Dev/AiMissionLogWriterDev.cs" Link="Dev/AiMissionLogWriterDev.cs" />
    <Compile Include="../OpenRA.Mods.Cameo.Dev/BotPassiveDiagnosticWriterCA.cs" Link="Dev/BotPassiveDiagnosticWriterCA.cs" />
    <Compile Include="../OpenRA.Mods.Cameo.Dev/AiEconomyHealthLogWriter.cs" Link="Dev/AiEconomyHealthLogWriter.cs" />
    <Compile Include="../OpenRA.Mods.Cameo.Dev/AiLogFileAppender.cs" Link="Dev/AiLogFileAppender.cs" />
    <Compile Include="../OpenRA.Mods.Cameo.Dev/AiLogWriteQueue.cs" Link="Dev/AiLogWriteQueue.cs" />
    <Compile Include="../OpenRA.Mods.Cameo.Dev/DevCashBonus.cs" Link="Dev/DevCashBonus.cs" />
    <!-- DEV-only pure class: guarded out of the release Cameo assembly, compiled into the test assembly only when the Cameo assembly does not have it. -->
    <Compile Include="../OpenRA.Mods.Cameo/Traits/DefendReactionTracker.cs" Link="Dev/DefendReactionTracker.cs" Condition="'$(CameoDevLogging)' != 'true'" />
    <ProjectReference Include="../OpenRA.Mods.Cameo.Unified/OpenRA.Mods.Cameo.Unified.csproj" />
    <ProjectReference Include="../OpenRA.Mods.Fransbot/OpenRA.Mods.Fransbot.csproj" />
    <ProjectReference Include="../engine/OpenRA.Test/OpenRA.Test.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="NUnit" Version="4.3.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../OpenRA.Mods.Cameo/Traits/SlaveMinerSpawnerSlave.cs"
          Link="source/SlaveMinerSpawnerSlave.cs"
          CopyToOutputDirectory="Always" />
    <None Include="../OpenRA.Mods.Cameo/Traits/SlaveMinerIdleRescue.cs"
          Link="source/SlaveMinerIdleRescue.cs"
          CopyToOutputDirectory="Always" />
    <None Include="../OpenRA.Mods.Cameo/Traits/SlaveMinerSpawnerMaster.cs"
          Link="source/SlaveMinerSpawnerMaster.cs"
          CopyToOutputDirectory="Always" />
    <!-- Every mod project's code, for the repo-wide "who queues a MoveToDock" audit pin. -->
    <None Include="../OpenRA.Mods.Cameo/**/*.cs" Exclude="../OpenRA.Mods.Cameo/obj/**;../OpenRA.Mods.Cameo/bin/**"
          Link="source/mods/Cameo/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../OpenRA.Mods.Cameo.Dev/AiPlayerTelemetryDev.cs"
          Link="source/mods/Cameo.Dev/AiPlayerTelemetryDev.cs" CopyToOutputDirectory="Always" />
    <None Include="MissionBuildLineOracle.cs" Link="source/MissionBuildLineOracle.cs" CopyToOutputDirectory="Always" />
    <None Include="../mods/cameo/mod.yaml" Link="source/packaging/cameo-mod.yaml" CopyToOutputDirectory="Always" />
    <None Include="../mods/cameo/rules/world.yaml" Link="source/packaging/world.yaml" CopyToOutputDirectory="Always" />
    <None Include="../mods/cameo/rules/player.yaml" Link="source/packaging/player.yaml" CopyToOutputDirectory="Always" />
    <None Include="../mods/cameo/rules/dev/logging.yaml" Link="source/packaging/dev-logging.yaml" CopyToOutputDirectory="Always" />
    <None Include="../Directory.Build.targets" Link="source/packaging/Directory.Build.targets" CopyToOutputDirectory="Always" />
    <None Include="../CameoDev.proj" Link="source/packaging/CameoDev.proj" CopyToOutputDirectory="Always" />
    <None Include="../packaging/functions.sh" Link="source/packaging/functions.sh" CopyToOutputDirectory="Always" />
    <None Include="../packaging/linux/buildpackage.sh" Link="source/packaging/linux-buildpackage.sh" CopyToOutputDirectory="Always" />
    <None Include="../packaging/macos/buildpackage.sh" Link="source/packaging/macos-buildpackage.sh" CopyToOutputDirectory="Always" />
    <None Include="../packaging/windows/buildpackage.sh" Link="source/packaging/windows-buildpackage.sh" CopyToOutputDirectory="Always" />
    <None Include="../OpenRA.Mods.CA/**/*.cs" Exclude="../OpenRA.Mods.CA/obj/**;../OpenRA.Mods.CA/bin/**"
          Link="source/mods/CA/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../OpenRA.Mods.Cameo.Unified/**/*.cs" Exclude="../OpenRA.Mods.Cameo.Unified/obj/**;../OpenRA.Mods.Cameo.Unified/bin/**"
          Link="source/mods/Unified/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../OpenRA.Mods.Fransbot/**/*.cs" Exclude="../OpenRA.Mods.Fransbot/obj/**;../OpenRA.Mods.Fransbot/bin/**"
          Link="source/mods/Fransbot/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../engine/OpenRA.Mods.Common/Traits/Harvester.cs"
          Link="source/engine_Harvester.cs"
          CopyToOutputDirectory="Always" />
    <None Include="../engine/OpenRA.Mods.Common/Activities/FindAndDeliverResources.cs"
          Link="source/engine_FindAndDeliverResources.cs"
          CopyToOutputDirectory="Always" />
    <None Include="../engine/OpenRA.Game/Actor.cs"
          Link="source/engine_Actor.cs"
          CopyToOutputDirectory="Always" />
  </ItemGroup>
  <!-- CannonAP generated-heaviness fixtures, copied next to the test DLL and
       referenced via a relative output path (no absolute machine paths). -->
  <ItemGroup>
    <None Include="../mods/cameo/ai/ai.yaml"
          Link="tools/tests/fixtures/mcv_deploy_ai.yaml"
          CopyToOutputDirectory="Always" />
    <None Include="../tools/ai/increment_switches.yaml"
          Link="tools/tests/fixtures/increment_switches.yaml"
          CopyToOutputDirectory="Always" />
    <None Include="../tools/tests/fixtures/mcv_deploy_cell_legacy_block.yaml"
          Link="tools/tests/fixtures/mcv_deploy_cell_legacy_block.yaml"
          CopyToOutputDirectory="Always" />
    <None Include="../tools/tests/fixtures/cannonap_continuous_generated.yaml"
          Link="tools/tests/fixtures/cannonap_continuous_generated.yaml"
          CopyToOutputDirectory="Always" />
    <None Include="../tools/tests/fixtures/cannonap_continuous_fixture.json"
          Link="tools/tests/fixtures/cannonap_continuous_fixture.json"
          CopyToOutputDirectory="Always" />
    <!-- SW-cap wiring fixtures: the real host yaml files scanned by
         SuperweaponPlugLimitYamlTest to pin the four global-swlimit providers. -->
    <None Include="../mods/cameo/ContentPacks/TiberianDawn/GDI/yaml/buildings.yaml"
          Link="tools/tests/fixtures/swcap/td_gdi_buildings.yaml"
          CopyToOutputDirectory="Always" />
    <None Include="../mods/cameo/ContentPacks/TiberianDawn/Nod/yaml/buildings.yaml"
          Link="tools/tests/fixtures/swcap/td_nod_buildings.yaml"
          CopyToOutputDirectory="Always" />
    <None Include="../mods/cameo/ContentPacks/TiberianSun/CABAL/yaml/buildings.yaml"
          Link="tools/tests/fixtures/swcap/cabal_buildings.yaml"
          CopyToOutputDirectory="Always" />
    <None Include="../mods/cameo/ContentPacks/TiberianSun/CABAL/yaml/defenses.yaml"
          Link="tools/tests/fixtures/swcap/cabal_defenses.yaml"
          CopyToOutputDirectory="Always" />
    <None Include="../mods/cameo/ContentPacks/TiberianSun/GDI/yaml/buildings.yaml"
          Link="tools/tests/fixtures/swcap/ts_gdi_buildings.yaml"
          CopyToOutputDirectory="Always" />
    <!-- world.yaml carries the declared OccupancyTokens catalogue the scans
         cross-check against the provider wiring. -->
    <None Include="../mods/cameo/rules/world.yaml"
          Link="tools/tests/fixtures/swcap/world.yaml"
          CopyToOutputDirectory="Always" />
  </ItemGroup>
</Project>
