<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <EngineRootPath>../engine</EngineRootPath>
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>
  <Import Project="../engine/Directory.Build.props" />
  <ItemGroup>
    <ProjectReference Include="../OpenRA.Mods.CA/OpenRA.Mods.CA.csproj" />
    <ProjectReference Include="../OpenRA.Mods.Cameo/OpenRA.Mods.Cameo.csproj" />
    <ProjectReference Include="../OpenRA.Mods.Cameo.Unified/OpenRA.Mods.Cameo.Unified.csproj" />
    <ProjectReference Include="../OpenRA.Mods.Fransbot/OpenRA.Mods.Fransbot.csproj" />
    <ProjectReference Include="../engine/OpenRA.Test/OpenRA.Test.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="NUnit" Version="4.3.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
  <!-- CannonAP generated-heaviness fixtures, copied next to the test DLL and
       referenced via a relative output path (no absolute machine paths). -->
  <ItemGroup>
    <None Include="../tools/tests/fixtures/cannonap_continuous_generated.yaml"
          Link="tools/tests/fixtures/cannonap_continuous_generated.yaml"
          CopyToOutputDirectory="Always" />
    <None Include="../tools/tests/fixtures/cannonap_continuous_fixture.json"
          Link="tools/tests/fixtures/cannonap_continuous_fixture.json"
          CopyToOutputDirectory="Always" />
    <!-- SW-cap wiring fixtures: the real host yaml files scanned by
         SuperweaponPlugLimitYamlTest to pin the four global-swlimit providers. -->
    <None Include="../mods/cameo/ContentPacks/TiberianDawn/GDI/yaml/buildings.yaml"
          Link="tools/tests/fixtures/swcap/td_gdi_buildings.yaml"
          CopyToOutputDirectory="Always" />
    <None Include="../mods/cameo/ContentPacks/TiberianDawn/Nod/yaml/buildings.yaml"
          Link="tools/tests/fixtures/swcap/td_nod_buildings.yaml"
          CopyToOutputDirectory="Always" />
    <None Include="../mods/cameo/ContentPacks/TiberianSun/CABAL/yaml/buildings.yaml"
          Link="tools/tests/fixtures/swcap/cabal_buildings.yaml"
          CopyToOutputDirectory="Always" />
    <None Include="../mods/cameo/ContentPacks/TiberianSun/CABAL/yaml/defenses.yaml"
          Link="tools/tests/fixtures/swcap/cabal_defenses.yaml"
          CopyToOutputDirectory="Always" />
    <None Include="../mods/cameo/ContentPacks/TiberianSun/GDI/yaml/buildings.yaml"
          Link="tools/tests/fixtures/swcap/ts_gdi_buildings.yaml"
          CopyToOutputDirectory="Always" />
  </ItemGroup>
</Project>
