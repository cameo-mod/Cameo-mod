actor_cabal_engineer =
   .name = CABAL Engineer
   .description = Support cyborg that repairs friendly mechanical units with a rechargeable beam.
      Captures enemy structures and repairs bridges.
      Unarmed.

actor_cabal_cyborginfantry =
   .name = Cyborg Infantry
   .description = Basic cybernetic soldier armed with a chaingun.
      Slows down when critically damaged.
      Strong vs Infantry, Light armor
      Weak vs Vehicles, Aircraft

actor_cabal_ravager =
   .name = Ravager
   .description = Heavy armored cyborg with a short-range plasma cannon.
      Neutron Nuclear Catalyst swaps plasma for neutron shells.
      Strong vs Vehicles, Buildings, Infantry
      Weak vs Aircraft

actor_cabal_rocketcyborg =
   .name = Rocket Cyborg
   .description = Anti-tank and anti-air cyborg armed with rockets.
      Dark Armament increases rocket burst size.
      Strong vs Vehicles, Aircraft
      Weak vs Infantry

actor_cabal_devout =
   .name = Devout
   .description = Promotion replacement for Cyborg Infantry, armed with dual chainguns.
      Strong vs Infantry, Light armor
      Weak vs Vehicles, Aircraft

actor_cabal_ascended =
   .name = Ascended
   .description = Promotion replacement for Rocket Cyborg, a heavy anti-armor walker with dual rocket pods.
      Strong vs Vehicles, Aircraft
      Weak vs Infantry

actor_cabal_hackercyborg =
   .name = Hacker Cyborg
   .description = Support cyborg that can remotely control enemy robotic units and vehicles.
      Neural Uplink reduces hacking cooldown by 20%.
      Maximum capacity of 8 controlled units.
      Strong vs Vehicles, Robots
      Weak vs Infantry, Aircraft

actor_cabal_cyborgcommando =
   .name = Cyborg Commando
   .description = Elite hero cyborg armed with a powerful plasma cannon.
      Neutron Nuclear Catalyst swaps plasma for neutron shells.
      Maximum 1 can be trained.
      Strong vs Infantry, Vehicles, Buildings
      Weak vs Aircraft

actor_cabal_cyborgcommandov2 =
   .name = Cyborg Commando V2
   .description = Upgraded elite hero cyborg with an enhanced plasma cannon.
      Neutron Nuclear Catalyst swaps plasma for neutron shells.
      Maximum 1 can be trained.
      Strong vs Infantry, Vehicles, Buildings
      Weak vs Aircraft

actor_cabal_eliminator800 =
   .name = Eliminator 800
   .description = Heavy cybernetic infantry armed with a gatling gun and anti-air missiles.
      Can detect cloaked and hijacker units.
      Strong vs Infantry, Light armor, Aircraft
      Weak vs Vehicles

actor_cabal_coredefender =
   .name = Core Defender
   .description = CABAL epic superheavy walker with dual heavy lasers and rapid self-repair.
      Can detect cloaked units and crush vehicles.
      Maximum 1 can be trained.
      Strong vs Ground targets
      Weak vs Aircraft

actor_cabal_cyborgreaper =
   .name = Cyborg Reaper
   .description = Walker armed with anti-ground and anti-air missiles.
      Can immobilize infantry with trap nets.
      Strong vs Vehicles, Aircraft
      Can immobilize Infantry

actor_cabal_dissolver =
   .name = Dissolver
   .description = Anti-tank walker that sprays corrosive fluid.
      Regenerates health while attacking.
      Strong vs Vehicles
      Weak vs Infantry, Aircraft

actor_cabal_tiberiumharvester =
   .name = Tiberium Harvester
   .description = Harvests Tiberium and returns it to a Refinery for processing.
      Unarmed.

actor_cabal_laserspider =
   .name = Laser Spider
   .description = Fast scout walker armed with dual laser cannons.
      Strong vs Infantry, Light armor
      Weak vs Vehicles, Aircraft

actor_cabal_mantis =
   .name = Mantis
   .description = Very fast fire support strider with a frontal beam cannon.
      Strong vs Infantry, Light armor
      Weak vs Aircraft

actor_cabal_manticore =
   .name = Manticore
   .description = Heavy line-breaker walker armed with laser and missile weapons.
      Can immobilize infantry with trap nets.
      Backup Systems leaves a repairable husk when destroyed.
      Strong vs Vehicles, Aircraft
      Can immobilize Infantry

actor_cabal_artilleryspider =
   .name = Artillery Spider
   .description = Long-range artillery walker.
      Neutron Nuclear Catalyst replaces shells with neutron warheads.
      Backup Systems leaves a repairable husk when destroyed.
      Strong vs Infantry, Buildings
      Weak vs Vehicles, Aircraft

actor_cabal_tarantula =
   .name = Tarantula
   .description = General-purpose mechanized tank with a turreted cannon.
      Can detect cloaked units.
      Neutron Nuclear Catalyst replaces shells with neutron warheads.
      Backup Systems leaves a repairable husk when destroyed.
      Strong vs Vehicles
      Weak vs Infantry, Aircraft

actor_cabal_scarabapc =
   .name = Scarab APC
   .description = Hover troop transport that comes pre-loaded with infantry.
      Can move over water.
      Unarmed.

actor_cabal_eliminator1000 =
   .name = Eliminator 1000
   .description = Heavy melee hero cyborg armed with blade weapons.
      Regenerates health quickly.
      Maximum 1 can be trained.
      Strong vs Infantry, Light armor
      Weak vs Vehicles, Aircraft

actor_cabal_upgrade_mobilitymatrix =
   .name = Mobility Matrix
   .description = Tech Upgrade (Only affects units of own faction)
      Increases walker speed by 25%.
      Reduces incoming damage by 10%.

actor_cabal_upgrade_darkarmament =
   .name = Dark Armament
   .description = Tech Upgrade (Only affects units of own faction)
      Reloads infantry weapons 10% faster.
      Upgrades Rocket Cyborg rockets for increased burst size.

actor_cabal_missilesilo =
   .name = CABAL Missile Silo
   .description = Add-on for the CABAL Core that arms the Cabal Magic Nuke superweapon.
      Requires a CABAL Core and tech level superweapons.

actor_cabal_upgrade_neutronnuclearcatalyst =
   .name = Neutron Nuclear Catalyst
   .description = Tech Upgrade (Only affects units of own faction)
      Replaces conventional weapons with neutron shells on Ravager, Cyborg Commando, Cyborg Commando V2, Artillery Spider, and Tarantula.

actor_cabal_upgrade_radarhack =
   .name = Radar Hack
   .description = Tech Upgrade (Only affects units of own faction)
      Unlocks the Radar Hack support power, revealing a target area of the map.

actor_cabal_upgrade_networkedcombatprotocols =
   .name = Networked Combat Protocols
   .description = Tech Upgrade (Only affects units of own faction)
      Increases all unit firepower by 8%.
      Increases all unit reload speed by 5%.

actor_cabal_upgrade_backupsystems =
   .name = Backup Systems
   .description = Tech Upgrade (Only affects units of own faction)
      Heavy vehicles leave a repairable husk when destroyed.
      The husk reactivates if it is not destroyed.

actor_cabal_upgrade_handof =
   .name = Hand of CABAL
   .description = Tech Upgrade (Only affects units of own faction)
      Periodically spawns free Hacker Cyborgs from the Tech Center.
      Increases Hacker Cyborg speed by 25%.

actor_cabal_upgrade_dataworm =
   .name = Data Worm
   .description = Tech Upgrade (Only affects units of own faction)
      Unlocks the Data Worm support power at the CABAL Core.
      Hijacks a Hunter-Seeker droid and launches it at a target, instantly killing mobile units.

actor_cabal_upgrade_firewallprotocol =
   .name = Firewall Protocol
   .description = Tech Upgrade (Only affects units of own faction)
      CABAL units become immune to enemy mind control and vehicle hijacking.

actor_cabal_upgrade_clusterwarhead =
   .name = Cluster Warhead
   .description = Tech Upgrade (Only affects units of own faction)
      Replaces the Missile Silo warhead with a neutron cluster warhead.
      Spreads damage across a wider area on impact.

actor_cabal_upgrade_reinforcedchassis =
   .name = Reinforced Chassis
   .description = Tech Upgrade (Only affects units of own faction)
      Increases armor of Laser Spider, Mantis, and Spider Tank Drone by 15%.

actor_cabal_upgrade_overchargedservos =
   .name = Overcharged Servos
   .description = Tech Upgrade (Only affects units of own faction)
      Infantry move and turn 40% faster and reload 30% faster.
      Vehicles move and turn 20% faster and reload 15% faster.

actor_cabal_upgrade_neuraluplink =
   .name = Neural Uplink
   .description = Tech Upgrade (Only affects units of own faction)
      Hacker Cyborg hacking attacks reload 20% faster.

actor_cabal_upgrade_reclamationprotocols =
   .name = Reclamation Protocols
   .description = Tech Upgrade (Only affects units of own faction)
      Increases self-repair rate of Cyborg Infantry and Plated Armor Cyborgs.

actor_cabal_upgrade_fullassimilation =
   .name = Full Assimilation
   .description = Tech Upgrade (Only affects units of own faction)
      Increases unit sight range by 20%.
      Increases cloak detection range by 20%.

actor_cabal_promotion_devout =
   .name = Unlock Devout
   .description = Promotion Upgrade.
      Replaces Cyborg Infantry with the more powerful Devout.

actor_cabal_promotion_ascended =
   .name = Unlock Ascended
   .description = Promotion Upgrade.
      Replaces Rocket Cyborg with the Ascended anti-armor walker.

actor_cabal_promotion_manticore =
   .name = Unlock Manticore
   .description = Promotion Upgrade.
      Enables construction of the Manticore heavy walker.
