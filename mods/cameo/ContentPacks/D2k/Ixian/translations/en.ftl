# d2k Ixian pack strings (faction descriptions live in mods/cameo/fluent/rules/en.ftl).

actor_ixian_lightinfantry =
   .name = Ixian Light Infantry
   .description = Fast scout infantry armed with a light machine gun.
      Can be upgraded with Tungsten Needle Guns, Personal Shields, and General Purpose Armor.
      Strong vs Infantry
      Weak vs Vehicles, Aircraft

actor_ixian_rockettrooper =
   .name = Ixian Rocket Trooper
   .description = Anti-tank/anti-air infantry armed with a rocket launcher.
      Can be upgraded with Heavy Missiles, Personal Shields, and General Purpose Armor.
      Strong vs Vehicles, Aircraft
      Weak vs Infantry

upgrade_ixian_twin_rocket_trooper =
   .description = Upgrades Ixian Rocket Troopers with Twin Rocket Troopers.
